{
  "title": "Lemma cache and ingest",
  "uid": "lemma-cache",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "10s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lemma cache hits",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(lemma_cache_hits_total)", "refId": "A" }]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Lemma cache misses",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{ "expr": "sum(lemma_cache_misses_total)", "refId": "A" }]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Score cache hits",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "targets": [{ "expr": "sum(score_cache_hits_total)", "refId": "A" }]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Score cache misses",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 0 },
      "targets": [{ "expr": "sum(score_cache_misses_total)", "refId": "A" }]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Cache hit rate",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "targets": [
        {
          "expr": "(sum(lemma_cache_hits_total) + sum(score_cache_hits_total)) / ((sum(lemma_cache_hits_total) + sum(lemma_cache_misses_total) + sum(score_cache_hits_total) + sum(score_cache_misses_total)) > 0)",
          "refId": "A",
          "legendFormat": "hit rate"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Feed query p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(feed_query_seconds_bucket{job=\"api\"}[5m])) by (le))",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Invalidation strategy",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "targets": [
        {
          "expr": "sum by (strategy) (score_invalidations_total)",
          "refId": "A",
          "legendFormat": "{{strategy}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "Articles ingested per hour",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 22 },
      "targets": [
        {
          "expr": "sum by (language) (increase(worker_articles_ingested_total{job=\"worker\"}[1h]))",
          "refId": "A",
          "legendFormat": "{{language}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Lemmatization time per article p95",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 22 },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(nlp_article_seconds_bucket{job=\"worker\"}[15m])) by (le))",
          "refId": "A"
        }
      ]
    }
  ]
}
